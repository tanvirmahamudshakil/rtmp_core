[Unit]
Description=Active HLS playback-session counter (includes Varnish cache hits)
After=varnish.service
Requires=varnish.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/viewer_estimator.py
EnvironmentFile=-/etc/rtmp-server/rtmp-server.env
Restart=on-failure
RestartSec=2
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/streamforge/internal

[Install]
WantedBy=multi-user.target
