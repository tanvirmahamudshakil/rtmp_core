# Litestream configuration for StreamForge's control-plane database.
#
# Litestream tails the SQLite WAL and continuously streams every committed
# transaction to object storage — the write path for multi-node state
# replication (docs/high-availability.md). It does not make SQLite a
# multi-writer database: exactly one origin (the leader, see ha-agent.sh)
# writes at a time. Every other candidate origin runs `litestream replicate
# -readonly`-style continuous restore (ha-agent.sh's hydrate loop) so its copy
# of the database is always within seconds of the leader's.
#
# Install:
#   curl -LO https://github.com/benbjohnson/litestream/releases/latest/download/litestream-linux-amd64.tar.gz
#   tar -xzf litestream-linux-amd64.tar.gz -C /usr/local/bin litestream
#   install -d -m 0750 -o rtmp-server -g rtmp-server /etc/litestream
#   install -m 0640 -o rtmp-server -g rtmp-server deploy/ha/litestream.yml.example /etc/litestream.yml
#   # edit the bucket/credentials below, then:
#   systemctl enable --now litestream

dbs:
  - path: /var/lib/rtmp-server/rtmp.db
    replicas:
      - type: s3
        # Any S3-compatible endpoint works: AWS S3, MinIO, Backblaze B2,
        # Cloudflare R2, Wasabi. Leave `endpoint` unset for real AWS S3.
        bucket: ${STREAMFORGE_HA_BUCKET}
        path: rtmp-db
        endpoint: ${STREAMFORGE_HA_S3_ENDPOINT}
        region: ${STREAMFORGE_HA_S3_REGION:-us-east-1}
        access-key-id: ${STREAMFORGE_HA_S3_ACCESS_KEY}
        secret-access-key: ${STREAMFORGE_HA_S3_SECRET_KEY}
        # Sync interval: how far behind the replica can be. 1s is litestream's
        # own default and is fine for this database — it holds control-plane
        # state (applications, streams, assignments, targets, cluster nodes),
        # never per-segment media, so write volume is low (operator actions,
        # heartbeats every ~10s) and the WAL rarely grows large between syncs.
        sync-interval: 1s
        # Keep enough history to survive a leader being down for a while
        # without losing the ability to restore. Snapshots are periodic full
        # copies; retention below that boundary is pruned.
        retention: 72h
        retention-check-interval: 1h
