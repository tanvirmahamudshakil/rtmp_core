# Environment for streamforge-ha-agent.service. Copy to
# /etc/streamforge/ha-agent.env (mode 0640, owner rtmp-server:rtmp-server) and
# edit per node. See the top of ha-agent.sh for what every variable does.

# Unique per candidate -- do not copy this file verbatim between origin-a and
# origin-b without changing this.
STREAMFORGE_HA_NODE_ID=origin-a

STREAMFORGE_HA_BUCKET=your-streamforge-ha-bucket
# Leave unset for real AWS S3; set for MinIO/R2/B2/etc.
#STREAMFORGE_HA_S3_ENDPOINT=https://s3.your-provider.example.com
STREAMFORGE_HA_S3_REGION=us-east-1

# AWS-cli credential env vars (the agent shells out to `aws s3api`).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set to 1 on exactly ONE node, exactly ONCE, on the very first bring-up of a
# brand new deployment (empty bucket, no lease, no replica to restore from).
# Remove or set to 0 immediately after that node has become leader -- every
# subsequent failover is automatic and must not re-bootstrap.
STREAMFORGE_HA_BOOTSTRAP_LEADER=0
