# Production join-path override for the current kk/KK link.
# scripts/install-linux.sh now generates this behavior by default. Override it
# for another deployment with RTMP_FAST_JOIN_APPLICATION,
# RTMP_FAST_JOIN_STREAM and RTMP_FAST_JOIN_RENDITION.
#
# Existing players keep using the rendition URL already loaded. A fresh open
# of the stable master link is rewritten to the 480p media playlist, avoiding
# a 720p cold start while the origin is close to its egress ceiling.
:80 {
    # Avoid per-request compression CPU on the high-volume media path.
    @compressible not path /hls/*
    encode @compressible zstd gzip

    @control path /api/*
    handle @control {
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:8080
    }

    @edge_stats path /internal/viewer_estimate.json
    handle @edge_stats {
        root * /var/www/streamforge
        header Cache-Control "no-store"
        file_server
    }

    @kk_join path /hls/kk/KK/master.m3u8
    handle @kk_join {
        # The public high-scale cache normalizes query strings and all viewers
        # share this startup playlist object.
        uri replace /hls/kk/KK/master.m3u8 /hls/kk/KK_480p/index.m3u8
        reverse_proxy 127.0.0.1:6081
    }

    # Both playlists and segments use the local shared cache. A large audience
    # therefore causes cache hits, not a proportional increase in origin work.
    @hls path /hls/*
    handle @hls {
        reverse_proxy 127.0.0.1:6081
    }

    handle {
        root * /var/www/streamforge
        try_files {path} /index.html
        file_server
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
}
