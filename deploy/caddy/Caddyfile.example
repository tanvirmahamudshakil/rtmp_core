# Example Caddyfile. Copy to /etc/caddy/Caddyfile and edit for your environment.
:80 {
    encode zstd gzip

    @control path /api/*
    handle @control {
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:8080
    }

    # StreamForge scaling tuning
    @hls path /hls/*
    handle @hls {
        reverse_proxy 127.0.0.1:8080

        @seg path *.ts
        header @seg Cache-Control "public, max-age=31536000, immutable"

        @pl path *.m3u8
        header @pl Cache-Control "no-cache, must-revalidate"
    }

    handle {
        root * /var/www/streamforge
        try_files {path} /index.html
        file_server
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
}
