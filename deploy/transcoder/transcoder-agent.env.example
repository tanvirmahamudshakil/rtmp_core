# Listener used by the origin for POST/DELETE /jobs.
RTMP_TRANSCODER_BIND=0.0.0.0
RTMP_TRANSCODER_PORT=9200
RTMP_TRANSCODER_MAX_JOBS=8

# Cluster registration. MANAGEMENT_URL is the origin's management endpoint;
# NODE_ADDRESS is this host as the origin can reach it (no scheme or port).
STREAMFORGE_MANAGEMENT_URL=http://origin.internal:8080
STREAMFORGE_NODE_ID=transcoder-1
STREAMFORGE_NODE_ROLE=transcoder
STREAMFORGE_NODE_ADDRESS=transcoder-1.internal
STREAMFORGE_NODE_REGION=local
STREAMFORGE_NODE_CAPACITY=8
STREAMFORGE_TRANSCODER_AGENT_URL=http://127.0.0.1:9200
STREAMFORGE_NODE_DRAINING=0
