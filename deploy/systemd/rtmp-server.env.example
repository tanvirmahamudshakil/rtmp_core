# Environment file for the rtmp-server systemd unit.
#
# Install to /etc/rtmp-server/rtmp-server.env with mode 0640, owner
# root:rtmp-server, so the service can read it but no other user can:
#
#   sudo install -m 0640 -o root -g rtmp-server \
#       deploy/systemd/rtmp-server.env.example /etc/rtmp-server/rtmp-server.env
#
# Every key in core::ServerConfig has an override here, named
# RTMP_SERVER_<UPPER_SNAKE_CASE_KEY> (src/core/config.cpp, apply_env_overrides).
# Precedence is CLI > environment > config file > built-in default.
#
# Put SECRETS here and nothing else if you can: /etc/rtmp-server/server.yaml
# is then safe to manage with configuration management and to check into a
# (private) repository, while this file is the only thing needing secret
# handling.
#
# systemd EnvironmentFile syntax notes -- these are not shell scripts:
#   - no `export`
#   - no command substitution, no variable expansion
#   - quotes are stripped, so VALUE and "VALUE" are identical
#   - a value containing '#' must be quoted or the rest is treated as a comment

# --- Secrets (required; the server refuses to start without them) --------
#
# Both must be at least 32 characters, must not be a well-known placeholder,
# must not be a single repeated character, and must differ from each other --
# ServerConfig::validate() enforces all four and exits non-zero otherwise
# (docs/v2_promot.md PHASE 8 "Release gates": insecure defaults must fail).
#
# Generate each independently:
#   openssl rand -hex 32
#
# Signs and verifies playback tokens. Rotating it invalidates every
# outstanding signed playback URL -- see docs/deployment.md "Secret rotation".
RTMP_SERVER_TOKEN_SIGNING_SECRET=CHANGE_ME_openssl_rand_hex_32

# Authenticates management API callers. Never expose the management API to the
# internet even with this set -- see docs/deployment.md "Management API
# exposure".
RTMP_SERVER_API_AUTHENTICATION_SECRET=CHANGE_ME_A_DIFFERENT_openssl_rand_hex_32

# --- Network -------------------------------------------------------------
# RTMP ingest/egress. 0.0.0.0 is correct here: this is the public service.
RTMP_SERVER_RTMP_BIND_ADDRESS=0.0.0.0
RTMP_SERVER_RTMP_PORT=1935

# Management API + /metrics + /health. Bind to loopback and reach it through
# an authenticated reverse proxy or an SSH tunnel. Changing this to 0.0.0.0
# publishes stream-key rotation and disconnect endpoints to the network.
RTMP_SERVER_API_BIND_ADDRESS=127.0.0.1
RTMP_SERVER_API_PORT=8080

# Hostname baked into the publish/playback URLs the management API returns.
# Set it to what encoders and players will actually connect to.
RTMP_SERVER_PUBLIC_RTMP_HOSTNAME=stream.example.com

# --- Capacity ------------------------------------------------------------
# Keep LimitNOFILE in the unit file consistent with maximum_connections; see
# the sizing note there.
RTMP_SERVER_MAXIMUM_CONNECTIONS=10000
RTMP_SERVER_MAXIMUM_CONNECTIONS_PER_IP=50
RTMP_SERVER_MAXIMUM_PUBLISHERS=1000
RTMP_SERVER_MAXIMUM_VIEWERS_PER_STREAM=5000

# 0 = auto (hardware_concurrency, clamped to max_worker_ring_count).
RTMP_SERVER_WORKER_RING_COUNT=0

# --- Storage -------------------------------------------------------------
# Must be inside the unit's ReadWritePaths/StateDirectory.
RTMP_SERVER_DATABASE_TYPE=sqlite
RTMP_SERVER_DATABASE_CONNECTION=/var/lib/rtmp-server/rtmp.db
RTMP_SERVER_RECORDING_ENABLED=false
RTMP_SERVER_RECORDING_DIRECTORY=/var/lib/rtmp-server/recordings

# --- Transport tuning --------------------------------------------------
# Per-connection socket buffers and TCP write-pacing (Wowza "Tune for
# optimal performance"). 0 = kernel autosizing, which is throughput-optimal
# on a well-provisioned link. A non-zero send buffer bounds per-viewer
# kernel memory at high fan-out and surfaces a slow receiver to the write
# queue sooner. notsent_lowat must not exceed the send buffer and is
# ignored on kernels without TCP_NOTSENT_LOWAT. ServerConfig::validate()
# rejects a pinned buffer outside [2048, 67108864].
RTMP_SERVER_CLIENT_SEND_BUFFER_BYTES=262144
RTMP_SERVER_CLIENT_RECEIVE_BUFFER_BYTES=0
RTMP_SERVER_CLIENT_TCP_NOTSENT_LOWAT_BYTES=131072

# --- Allocator -------------------------------------------------------
# Cap glibc malloc arenas. The default (8 x CPU cores) lets resident memory
# balloon under a connection storm or many concurrent transcode threads,
# because per-arena free lists are not returned to the OS. Wowza's
# high-concurrency transcoding guidance starts at 4 x cores; on a pure
# ingest/HLS origin 2 is enough. Raise it if transcode throughput drops.
MALLOC_ARENA_MAX=4

# --- Observability -------------------------------------------------------
# trace|debug|info|warn|error. 'debug' logs per-connection lifecycle events;
# at thousands of connections that is a significant log volume, so keep it at
# 'info' in production.
RTMP_SERVER_LOG_LEVEL=info
RTMP_SERVER_METRICS_ENABLED=true
